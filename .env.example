# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI Provider: huggingface | nyckel | mock
VITE_AI_PROVIDER=mock

# Hugging Face (for huggingface provider)
VITE_HF_API_TOKEN=your-hf-token

# Nyckel (for nyckel provider)
VITE_NYCKEL_API_KEY=your-nyckel-api-key

# Web Push (VAPID). Generate keys with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
